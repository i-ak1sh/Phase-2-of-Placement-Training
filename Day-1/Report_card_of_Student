class StudentReportCard
{
	int rollNo;
	String name;
	int m1;
	int m2;
	int m3;
	int m4;
	int m5;
	int total;
	float avg;
	String grade;
	StudentReportCard(int rollNo, String name, int m1, int m2, int m3, int m4, int m5)
	{
		this.rollNo = rollNo;
		this.name = name;
		this.m1 = m1;
		this.m2 = m2;
		this.m3 = m3;
		this.m4 = m4;
		this.m5 = m5;
	}
	void calResult()
	{
		this.total = m1 + m2 + m3 + m4 + m5;
		this.avg = total / 5;
		if (avg > 9)
		{
			grade = "O";
		}
		else if (avg > 8)
		{
			grade = "A+";
		}
		else if (avg > 7)
		{
			grade = "A";
		}
		else if (avg > 6)
		{
			grade = "B+";
		}
		else if (avg > 5)
		{
			grade = "B";
		}
	}
	void getDetails()
	{
		System.out.println(this.rollNo + " " + this.name + " " + this.m1 + " " + this.m2 + " " + this.m3 + " " + this.m4 + " " + this.m5 +" " +
	this.total + " " + this.avg + " " + this.grade);
	}
}
public class Student_ReportCard 
{
	static public void main(String[] args)
	{
		StudentReportCard rc1 = new StudentReportCard(007, "Akash R", 10, 9, 7, 8, 10);
		rc1.calResult();
		rc1.grade = "A++";
		rc1.getDetails();
	}
}
