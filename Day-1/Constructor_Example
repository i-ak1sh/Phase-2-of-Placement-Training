class Employee
{
	int empId;
	String name;
	String gen;
	int age;
	Employee()
	{
		System.out.println("Qbj created");
	}
	Employee(int empId, String name, String gen, int age)
	{
		this.empId = empId;
		this.name = name;
		this.gen = gen;
		this.age = age;
	}
	void getEmployeeDetails()
	{
		System.out.println(this.empId + " " + this.name + " " + this.gen + " " + this.age);
	}
}
public class ConstructorExample 
{
	public static void main(String[] args)
	{
		Employee e1 = new Employee(007, "Akash R", "Male", 21);
		Employee e2 = new Employee();
		e1.getEmployeeDetails();
		e2.getEmployeeDetails();
	}
}
